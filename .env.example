# ==========================================================
# INKWELL MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================================

# ----------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ----------------------------------------------------------
# Set this in your Vercel Project Dashboard -> Settings -> Environment Variables.
# Replace with your deployed backend URL (Railway / Render / Vercel):
VITE_API_URL=https://your-backend-service.up.railway.app

# Optional alias (if using Next.js / Next conventions)
NEXT_PUBLIC_API_URL=https://your-backend-service.up.railway.app


# ----------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Railway / Render / Server)
# ----------------------------------------------------------
# MongoDB Atlas Connection String
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteapp?retryWrites=true&w=majority
# Alternative alias for database connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteapp?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_random_key_here

# Frontend origin allowed to make CORS requests (no trailing slash)
CLIENT_URL=https://noteapp-mu-ashy.vercel.app
# Legacy alias for frontend origin
FRONTEND_URL=https://noteapp-mu-ashy.vercel.app

# Server Port (automatically injected by Railway / Render)
PORT=3000

# Environment mode ('production' or 'development')
NODE_ENV=production
