# Backend environment configuration
# MongoDB connection string (supports both MONGO_URL and MONGODB_URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteapp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteapp?retryWrites=true&w=majority

# JWT secret key
JWT_SECRET=your_jwt_secret_key_here

# Allowed frontend origin for CORS (no trailing slash)
CLIENT_URL=https://noteapp-mu-ashy.vercel.app
FRONTEND_URL=https://noteapp-mu-ashy.vercel.app

# Port (injected by Railway / Render / cloud hosting)
PORT=3000

# Node environment mode
NODE_ENV=production
